# Exemple de configuration. Copiez ce fichier en .env et adaptez les valeurs.
# NE JAMAIS committer le fichier .env (il est ignoré par .gitignore).

# --- Backend Django ---
# Clé secrète Django : générez-en une avec `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Base de données PostgreSQL ---
POSTGRES_DB=quizdb
POSTGRES_USER=quizuser
POSTGRES_PASSWORD=quizpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (origines frontend autorisées) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# --- Frontend (Vite) ---
# URL de l'API telle que vue par le navigateur.
VITE_API_URL=http://localhost:8000
